---
import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout
  title="About | Rahmad Al Habib Khasary"
  description="About Rahmad Al Habib Khasary — full stack developer based in Cibinong, Bogor with 10 years of experience."
>
  <div class="stack gap-20">
    <main class="wrapper about">
      <Hero
        title="About"
        tagline="Thanks for stopping by. Read below to learn more about myself and my background."
      >
        <img
          width="1553"
          height="873"
          src="/assets/at-work.jpg"
          alt="Rahmad Al Habib Khasary at work with a colleague"
        />
      </Hero>

      <section>
        <h2 class="section-title">Background</h2>
        <div class="content">
          <p>
            I'm Rahmad Al Habib Khasary, a full stack developer based in
            Cibinong, Bogor, Indonesia. I've been building software since 2016 —
            starting as a freelance developer, then working across agencies and
            enterprises as a senior programmer, and now as a full stack
            developer at ALSOK Indonesia, where I own internal applications used
            by roughly 30,000 employees: attendance, carpooling, e-learning,
            and an integrated facility management system.
          </p>
          <p>
            My comfort zone is the whole stack: Laravel and React on a typical
            day, React Native or Flutter when it needs to run on a phone,
            Electron for desktop, and Node-RED or Python when the job involves
            hardware and integrations. I've shipped enterprise systems, client
            freelance projects, and small-business apps — each one teaches a
            different kind of discipline.
          </p>
          <p>
            These days I'm also building <strong>Bulbulls</strong>, a game
            top-up store, from an accepted proposal toward go-live — dynamic
            pricing, automatic supplier failover, and multi-payment gateway
            architecture. When I'm not writing code, I'm usually hunting for
            freelance gigs or tinkering with self-hosted tooling.
          </p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Experience</h2>
        <div class="content">
          <ul class="timeline">
            <li>
              <strong>Full Stack Developer — ALSOK Indonesia</strong>
              <span>2025 — Present</span>
              <p>Attendance system for ~30,000 employees, carpooling app, e-learning platform, and IFMS (Integrated Facility Management System).</p>
            </li>
            <li>
              <strong>Full Stack Developer — PT Sirius Parama Sistem</strong>
              <span>2025 — 2026</span>
            </li>
            <li>
              <strong>Full Stack Developer — Cipta Pernika Nusantara</strong>
              <span>2020 — 2025</span>
            </li>
            <li>
              <strong>Frontend Developer (Freelance) — Bank Sinarmas via Artha Semesta Puana</strong>
              <span>2022 — 2023</span>
            </li>
            <li>
              <strong>Programmer — Pindai Media Komunika</strong>
              <span>2019 — 2020</span>
            </li>
            <li>
              <strong>Senior Programmer — Azimuth Solusi Indonesia</strong>
              <span>2017 — 2019</span>
            </li>
            <li>
              <strong>Freelance Full Stack Developer — Keboen Coding</strong>
              <span>2016 — 2017</span>
            </li>
          </ul>
        </div>
      </section>
      <section>
        <h2 class="section-title">Education</h2>
        <div class="content">
          <p>
            <strong>S1 Teknologi Informasi</strong> — Universitas Indraprasta
            PGRI, Jakarta (2020), IPK 3.54. Thesis: online futsal field booking
            system (Android + web backend + Lumen API).
          </p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Skills</h2>
        <div class="content">
          <p>
            <strong>Languages & frameworks:</strong> PHP (Laravel, Lumen),
            JavaScript/TypeScript (React, React Native, Node.js), Dart
            (Flutter), Python, Java, Electron.
          </p>
          <p>
            <strong>Data & infra:</strong> MySQL, PostgreSQL, MongoDB, Docker,
            Linux, Node-RED.
          </p>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  img {
    margin-top: 1.5rem;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-200);
  }

  .section-title {
    grid-column-start: 1;
    font-size: var(--text-xl);
    color: var(--gray-0);
  }

  .content {
    grid-column: 2 / 4;
  }

  .content :global(a) {
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .content :global(a:hover),
  .content :global(a:focus) {
    text-decoration-color: currentColor;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .timeline li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .timeline span {
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  .timeline p {
    margin: 0.25rem 0 0;
    color: var(--gray-400);
    font-size: var(--text-md);
  }

  @media (min-width: 50em) {
    .about {
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
    }

    .about > :global(:first-child) {
      grid-column-start: 2;
    }

    section {
      display: contents;
      font-size: var(--text-lg);
    }
  }
</style>
